<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tela de venda</title>
    <link rel="stylesheet" href="/css/venda.css">
    
</head>
<body>
    
    <div class="cabecalho">
        <div class="comandos">
            <div class="esquerdo">
                <a href="/">
                    <button id="voltar-homepage" title="Voltar à homepage">↩️</button>
                </a>
            </div>
            <div class="direito">
                <div class="botoes">
                    <button onclick="mostrarClientes()">👤</button>
                    <button onclick="salvarVenda()">💾</button>
                    <button>🆕</button>
                    <button>🗂️</button>
                </div>
                <div>
                    <p>Cliente: 1 - Cliente balcão</p>
                </div>
            </div>
        </div>
        <div class="titulo-venda">
            <h1>Venda</h1>
            <input type="text" placeholder="id_venda...">
            <h3 id="data"></h3>
        </div>
        <div class="container-obs">
            <textarea id="observacao"></textarea>
            <img src="/imagens/pagina-venda/ampliar.png" alt="ampliar" onclick="ampliarObservacoes()">
        </div>
    </div>
    <div class="corpo">
        <div class="barra-navegacao">
            <div class="nav-btn" id="cardapio-btn">
                <label for="corpo-navegacao-cardapio">Cardápio</label>
            </div>
            <div class="nav-btn" id="carrinho-btn">
                <label for="corpo-navegacao-carrinho">Carrinho</label>
            </div>
            <div class="nav-btn" id="pagamento-btn">
                <label for="corpo-navegacao-pagamento">Forma de pagamento</label>
            </div>
        </div>
        <div class="esconder" id="corpo-navegacao-pagamento">
            <div class="formulario">
                <div>
                    <label for="select-forma-pagamento">Forma de pagamento</label>
                    <select id="select-forma-pagamento"></select>
                </div>
                <div>
                    <label for="input-valor-pagamento">Valor</label>
                    <input id="input-valor-pagamento" placeholder="0,00">
                </div>
                <div>
                    <label for="select-bandeira-pagamento">Bandeira</label>
                    <select id="select-bandeira-pagamento" disabled></select>
                </div>
                <div>
                    <label for="input-parcelas-pagamento">Parcelas</label>
                    <input id="input-parcelas-pagamento" placeholder="0" disabled>
                </div>
                <button onclick="lancarPagamento()">Lançar</button>
            </div>
            <div id="pagamentos-lancados">
                <table>
                    <thead>
                        <tr>
                            <th>Forma de pagamento</th>
                            <th>Valor</th>
                            <th>Bandeira</th>
                            <th>Parcelas</th>
                            <th>Excluir</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="status">
                <div id="status-total">TOTAL: <span>R$ 542,00</span></div>
                <div id="status-recebido">RECEBIDO: <span>R$ 130,00</span></div>
                <div id="status-falta">FALTA: <span>R$ 412,00</span></div>
                <div id="status-troco">TROCO: <span>R$ 0,00</span></div>
            </div>
        </div>

        <div class="esconder" id="corpo-navegacao-carrinho">
            
            <div>
                <div class="container-tabela">
                    <table>
                        <thead>
                            <tr class="editando-linha esconder"></tr>
                            <tr>
                                <th>#</th>
                                <th>id</th>
                                <th>descrição</th>
                                <th>valor</th>
                                <th>quantidade</th>
                                <th>total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    
                </div>
                <p id="carrinho-total-geral"></p>
            </div>
            <div class="acoes">
                <button onclick="editarCarrinho()">Editar✏️</button>
                <button 
                    onclick="fecharEdicaoCarrinho()" 
                    id="btn-cancelar-edicao" 
                    class="esconder"
                >Cancelar Edição</button>
                <button onclick="removerFromCart()">Remover✖️</button>
            </div>
        </div>
        
        <div id="corpo-navegacao-cardapio">
            <div class="container-tabela">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>id</th>
                            <th>descrição</th>
                            <th>valor</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="acoes">
                <button onclick="addToCart()">Adicionar➕</button>
            </div>
        </div>
    </div>

    <!-- ampliar observações -->
    <dialog id="modal-observacoes">
        <textarea id="modal-textarea"></textarea>
    </dialog>
    <dialog id="modal-clientes">
        <p>Lorem ipsum dolor sit amet consectetur</p><br>
        
    </dialog>

    <script src="https://unpkg.com/imask"></script>
    <script src="/javascript/venda.js"></script>
</body>
</html>